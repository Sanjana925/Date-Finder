<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- TOP BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rename Settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222" />

    </LinearLayout>


    <!-- SCROLLABLE SETTINGS -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- RENAME RULE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Rename rule"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <!-- DATE FORMAT -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Date format"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgDateFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbDateDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Default" />

                <RadioButton
                    android:id="@+id/rbDateCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Custom" />

            </RadioGroup>

            <Spinner
                android:id="@+id/spinnerDefaultDateFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etCustomDateFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Custom format, e.g. yyyy_MM_dd"
                android:singleLine="true"
                android:visibility="gone" />


            <!-- DATE SOURCE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Date source"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerDateSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


            <!-- NAME STYLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Name style"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgNameStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbDateOnly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date only" />

                <RadioButton
                    android:id="@+id/rbDateOriginal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date + original" />

                <RadioButton
                    android:id="@+id/rbOriginalDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Original name + date" />

            </RadioGroup>


            <!-- MEDIA TYPE LABEL -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Media type label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgMediaLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbLabelNone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="None" />

                <RadioButton
                    android:id="@+id/rbLabelAutomatic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Automatic (IMG_ / VID_)" />

                <RadioButton
                    android:id="@+id/rbLabelCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Custom" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Image label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etImageLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="IMG_"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Video label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etVideoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="VID_"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Other label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtherLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Other"
                android:singleLine="true" />


            <!-- SERIAL -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Serial number"
                android:textSize="18sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbSerial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Serial start"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSerialStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Serial digits"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSerialDigits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Serial position"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgSerialPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSerialBefore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Before date" />

                <RadioButton
                    android:id="@+id/rbSerialAfter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="After date" />

            </RadioGroup>


            <!-- EXAMPLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Rename example"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRenameExample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:text="IMG_0001_2020_11_26.jpg"
                android:textSize="15sp" />


            <!-- NO CHANGE -->

            <CheckBox
                android:id="@+id/cbShowNoChange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Show file with no change" />

        </LinearLayout>

    </ScrollView>


    <!-- SAVE -->

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="Save"
        android:textAllCaps="false" />

</LinearLayout>